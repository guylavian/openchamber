{
  "name": "@openchamber/web",
  "version": "2.0.2",
  "private": false,
  "type": "module",
  "main": "./dist-node/server/index.js",
  "types": "./dist-node/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-node/server/index.d.ts",
      "default": "./dist-node/server/index.js"
    },
    "./server/*": "./dist-node/server/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "openchamber": "./dist-node/bin/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run build:watch",
    "dev:server": "bun ../../scripts/build-builtin-extensions.mjs && OPENCHAMBER_RELAY_HOST=${OPENCHAMBER_RELAY_HOST:-off} bun server/index.js --port ${OPENCHAMBER_PORT:-3001}",
    "dev:server:watch": "bun ../../scripts/build-builtin-extensions.mjs && node ./scripts/dev-server-watch.mjs",
    "build:server": "node ./scripts/build-server.mjs && bun ./scripts/verify-server-artifact.mjs",
    "build": "bun run build:server && vite build",
    "build:watch": "bun ../../scripts/build-builtin-extensions.mjs && vite build --watch",
    "prepack": "bun run build:server",
    "type-check": "tsc --noEmit && tsc -p tsconfig.server.json",
    "lint": "eslint \"./src/**/*.{ts,tsx}\" \"./server/**/*.ts\" --config ../../eslint.config.js && node ../../scripts/check-assertion-budget.mjs",
    "test": "vitest run",
    "start": "node dist-node/bin/cli.js serve"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@octokit/rest": "^22.0.1",
    "@openchamber/sdk": "workspace:*",
    "@opencode/client": "2.0.18",
    "@opencode/schema": "2.0.18",
    "@simplewebauthn/server": "13.3.3",
    "bun-pty": "^0.4.8",
    "compression": "^1.8.2",
    "cron-parser": "^5.10.1",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.7",
    "jose": "^6.2.12",
    "jsonc-parser": "^3.3.1",
    "luxon": "^3.7.2",
    "node-pty": "1.2.0-beta.15",
    "openai": "^7.23.0",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "^0.2.2",
    "sherpa-onnx-node": "1.12.28",
    "simple-git": "^3.36.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-go": "^6.0.1",
    "@eslint/js": "^9.39.5",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@remixicon/react": "^4.9.0",
    "@simplewebauthn/browser": "13.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "next-themes": "^0.4.6",
    "nodemon": "^3.1.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "strip-json-comments": "^5.0.3",
    "supertest": "^7.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.15"
  },
  "files": [
    "dist",
    "dist-node",
    "public",
    "package.json",
    "README.md"
  ]
}
